namespace podmesh.machine;

enum GatewayRouteSource:byte {
  SERVICE = 0,
  INGRESS = 1,
}

table GatewayRoute {
  path_prefix:string;
  target_port:uint16;
  service_name:string;
  service_port:string;
  source:GatewayRouteSource = SERVICE;
}

table GatewayProviderRecord {
  manifest_id:string;
  peer_id:string;
  host:string;
  owner_public_key_b64:string;
  routes:[GatewayRoute];
  ttl_ms:uint32;
  last_updated_ms:uint64;
  version:uint16;
}

root_type GatewayProviderRecord;
